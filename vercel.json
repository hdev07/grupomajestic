{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/destinos/:slug",
      "destination": "/destinos/:slug.html"
    },
    {
      "source": "/estudio/:slug",
      "destination": "/estudio/:slug.html"
    },
    {
      "source": "/servicios/:slug",
      "destination": "/servicios/:slug.html"
    }
  ]
}
